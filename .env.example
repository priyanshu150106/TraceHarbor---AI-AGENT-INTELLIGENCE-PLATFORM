# ============================================
# TraceHarbor — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================

# ---------- PostgreSQL ----------
POSTGRES_USER=th
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=traceharbor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Backend (FastAPI) ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change_me_generate_a_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend host / port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ---------- Frontend (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- LLM Providers (needed for demo agents) ----------
# Leave blank until Phase 2+
OPENAI_API_KEY=

# ---------- Phase 6: Failure Intelligence & pgvector ----------
# Embedding provider: "fake" (for testing/local development), "openai", or leave blank to disable
EMBEDDING_PROVIDER=
EMBEDDING_DIMENSIONS=64
EMBEDDING_BATCH_SIZE=50
CLUSTERING_SIMILARITY_THRESHOLD=0.85
CLUSTERING_MIN_CLUSTER_SIZE=2
CLUSTERING_MAX_CANDIDATES=1000
