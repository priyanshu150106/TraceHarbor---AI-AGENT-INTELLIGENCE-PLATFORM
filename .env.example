# ============================================
# TraceHarbor — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================

# ---------- PostgreSQL ----------
POSTGRES_USER=th
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=traceharbor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
# Integration Test Database (used for running real PostgreSQL integration tests)
POSTGRES_TEST_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/traceharbor_test

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Backend (FastAPI) ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change_me_generate_a_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend host / port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Application Mode (set to false in production)
DEBUG=true

# CORS Allowed Origins (comma-separated domains, e.g. https://traceharbor.vercel.app)
# In development, localhost:3000 is automatically permitted when DEBUG=true.
# In production, CORS_ORIGINS must be explicitly specified (wildcard '*' is rejected).
CORS_ORIGINS=https://traceharbor.vercel.app

# Public Portfolio Demo Mode (enables safe, read-only demo tenant browsing for unauthenticated visitors)
DEMO_MODE=false
DEMO_PROJECT_ID=

# ---------- Abuse Protections & Rate Limiting ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEMO_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=300
MAX_REQUEST_BODY_BYTES=10485760

# ---------- Reverse Proxy & Client IP Verification ----------
# Set PROXY_HEADERS_ENABLED=true when behind Render, Cloudflare, or trusted reverse proxy
PROXY_HEADERS_ENABLED=false
TRUSTED_PROXIES=127.0.0.1,::1,testclient

# ---------- Frontend (Next.js) ----------
# PUBLIC CLIENT-SIDE VARIABLES (bundled into browser JavaScript):
# NEVER place live API keys (th_live_*) or secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional synthetic read-only demo key (prefix: 'th_demo_'). Leave blank for automatic demo mode.
NEXT_PUBLIC_DEMO_KEY=

# ---------- LLM Providers (needed for demo agents) ----------
# Leave blank until Phase 2+
OPENAI_API_KEY=

# ---------- Phase 6: Failure Intelligence & pgvector ----------
# Embedding provider: "fake" (for testing/local development), "openai", or leave blank to disable
EMBEDDING_PROVIDER=
EMBEDDING_DIMENSIONS=64
EMBEDDING_BATCH_SIZE=50
CLUSTERING_SIMILARITY_THRESHOLD=0.85
CLUSTERING_MIN_CLUSTER_SIZE=2
CLUSTERING_MAX_CANDIDATES=1000
